//Marks and Grades Toolkit
// Average using Variadic Parameters
func average(of marks: Int...) -> Double {
    if marks.isEmpty {
        return 0
    }

    let total = marks.reduce(0, +)
    return Double(total) / Double(marks.count)
}
print(average(of: 80, 90, 70, 60))          // 75.0

// Grade Calculation
func grade(for average: Double) -> String {
    if average >= 90 {
        return "O"
    } else if average >= 80 {
        return "A+"
    } else if average >= 70 {
        return "A"
    } else if average >= 60 {
        return "B"
    } else {
        return "RA"
    }
}
print(grade(for: 85))               // A+

// Statistics using Tuple and Optional
func stats(of marks: [Int]) -> (min: Int, max: Int, average: Double)? {
    if marks.isEmpty {
        return nil
    }
    let minimum = marks.min()!
    let maximum = marks.max()!
    let avg = Double(marks.reduce(0, +)) / Double(marks.count)

    return (minimum, maximum, avg)
}
print(stats(of: [80, 90, 70, 60])!)                 // (min: 60, max: 90, average: 75.0)

// Add Bonus Marks using Inout
func curve(_ marks: inout [Int], by bonus: Int = 5) {
    for i in marks.indices {
        marks[i] = min(marks[i] + bonus, 100)
    }
}
var marks = [70, 80, 95, 60]
curve(&marks)
print(marks)                                        // [75, 85, 100, 65]

